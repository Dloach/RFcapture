.pio/
.vscode/
.idea/
*.exe
*.bin
*.elf
node_modules/
tests/host/*.exe
tests/host/test_decoder
tests/host/test_ssh_terminal
tests/host/test_ir
tests/host/test_ir_file
tests/host/test_atomic_store
*.pdb
*.obj
*.ilk

# Boot dumps of every stored pulse train (RF_DIAG=1 prints these).  They contain
# the real codes of whatever remote is in NVS, so they stay on the machine that
# captured them - docs/README.md 2.2 explains how to regenerate one.
docs/signals-*.log
*.local.log

# Serial captures from debug sessions (cap-serial.py output) and temporary
# upload transcripts.
docs/cap-*.log
docs/upload-*.log
docs/wifi-*.log
docs/ssh-*.log
docs/build-*.log

# Standalone reference project used during NFC bring-up (superseded by the
# unified firmware's NFC TOOLS).  Its source is tracked on purpose: it is the
# compact, verified record of the old emulation path; its .pio/ build tree is
# already covered by the global rule above.
docs/ota-*.log
docs/flash-*.log
docs/rec-serial.log
docs/standalone.*
harness-bridge/__pycache__/

# Captured voice WAVs kept by the Host plugin for offline gain/model diagnosis.
# Real recordings — never commit (public repo, privacy).
harness-ws/plugin/stt-capture/

# Machine-specific Windows shortcuts (absolute paths, one-off toggles).
harness-bridge/*.lnk
# Python bytecode from the syntax checks.
__pycache__/
